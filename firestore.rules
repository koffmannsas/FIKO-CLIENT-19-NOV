rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function isSystemBot() {
      return isSignedIn() && request.auth.token.email == 'fiko-system-bot@fiko.internal';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (isSystemBot() || getUserCompanyId() == companyId);
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if isSystemBot() || (isSignedIn() && request.auth.uid == userId);
    }

    // --- COMPANIES COLLECTION ---
    match /companies/{companyId} {
      allow read, write: if isSignedIn();
    }

    // --- SUBSCRIPTIONS (Anti-Tamper Server Authority) ---
    match /subscriptions/{subId} {
      allow get: if isSystemBot() || (
        isSignedIn() && isValidId(subId) && (
          subId == getUserCompanyId() ||
          existing().companyId == getUserCompanyId()
        )
      );
      allow list: if isSystemBot() || (
        isSignedIn() && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId())
      );
      // Client can ONLY initialize a free 7-day trial on its own newly created company;
      // Paid upgrades, credits, cycles, and statuses are written strictly server-side.
      allow create: if isSystemBot() || (
        isSignedIn() &&
        isValidId(subId) &&
        incoming().companyId == subId &&
        incoming().plan in ['free', 'essai'] &&
        incoming().status in ['active', 'trialing'] &&
        exists(/databases/$(database)/documents/companies/$(subId)) &&
        get(/databases/$(database)/documents/companies/$(subId)).data.ownerId == request.auth.uid
      );
      allow update, delete: if isSystemBot();
    }

    // --- BILLING QUOTES, REQUESTS, INVOICES, LEDGER, ENTITLEMENTS, USAGE METERS, AUDIT ---
    match /billing_quotes/{quoteId} {
      allow get: if isSystemBot() || (isSignedIn() && isValidId(quoteId) && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId()));
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /subscription_change_requests/{requestId} {
      allow get: if isSystemBot() || (isSignedIn() && isValidId(requestId) && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId()));
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /invoices/{invoiceId} {
      allow get: if isSystemBot() || (isSignedIn() && isValidId(invoiceId) && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId()));
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /billing_ledger/{entryId} {
      allow get: if isSystemBot() || (isSignedIn() && isValidId(entryId) && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId()));
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /entitlements/{companyId} {
      allow get: if isSystemBot() || isCompanyMember(companyId);
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /usage_meters/{companyId} {
      allow get: if isSystemBot() || isCompanyMember(companyId);
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    match /billing_audit_events/{eventId} {
      allow get: if isSystemBot() || (isSignedIn() && isValidId(eventId) && (existing().ownerUid == request.auth.uid || existing().companyId == getUserCompanyId()));
      allow list: if isSystemBot() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create, update, delete: if isSystemBot();
    }

    // --- AGENTS & FIKO MEMORY ---
    match /fiko_memory/{memId} {
      allow read, write: if isSignedIn();
    }

    match /agents/{agentId} {
      allow read, write: if isSignedIn();
    }

    // --- LEADS COLLECTION ---
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // On update: client cannot forge or arbitrarily switch status to 'Payé' without server verification
      allow update: if isSignedIn() && (
        request.resource.data.status != 'Payé' ||
        resource.data.status == 'Payé' ||
        (request.resource.data.paidTransactionReference != null)
      );
      allow delete: if isSignedIn();
    }

    // --- TRANSACTIONS (PAYSTACK) ---
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      // Client cannot forge successful status; status updates to SUCCESS are executed server-side
      allow create: if isSignedIn() && request.resource.data.status == 'PENDING';
      allow update: if isSystemBot() || (isSignedIn() && (
        request.resource.data.status == resource.data.status ||
        resource.data.status != 'SUCCESS'
      ));
      allow delete: if false;
    }

    // --- MESSAGES & CAMPAIGNS ---
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }

    // --- FIKO KNOWLEDGE ENGINE V3.0 ---
    match /fiko_knowledge_profiles/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
    }

    match /knowledge_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_training/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_approvals/{approvalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_learning/{suggestionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_scan_jobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_learning_sessions/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }

    match /knowledge_versions/{versionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.companyId is string;
      allow delete: if isSignedIn();
    }
  }
}
